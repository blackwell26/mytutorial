[
  {
    "name": "grades-service",
    "image": "${ECR_REGISTRY}/mytutorial/grades-service:${IMAGE_TAG}",
    "portMappings": [{ "containerPort": 8082, "protocol": "tcp" }],
    "environment": [
      { "name": "SPRING_PROFILES_ACTIVE", "value": "k8s" },
      { "name": "EUREKA_CLIENT_SERVICEURL_DEFAULTZONE", "value": "http://eureka-server:8761/eureka/" },
      { "name": "SPRING_DATASOURCE_URL", "value": "jdbc:postgresql://${RDS_ENDPOINT}:5432/postgres" },
      { "name": "SPRING_DATASOURCE_USERNAME", "value": "postgres" },
      { "name": "SPRING_DATA_REDIS_HOST", "value": "${REDIS_ENDPOINT}" },
      { "name": "SPRING_DATA_REDIS_PORT", "value": "6379" }
    ],
    "secrets": [
      { "name": "SPRING_DATASOURCE_PASSWORD", "valueFrom": "${SECRET_ARN_DB}" },
      { "name": "APP_JWT_SECRET", "valueFrom": "${SECRET_ARN_JWT}" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/mytutorial/grades-service",
        "awslogs-region": "${AWS_REGION}",
        "awslogs-stream-prefix": "ecs",
        "awslogs-create-group": "true"
      }
    },
    "healthCheck": {
      "command": ["CMD-SHELL", "curl -sf http://localhost:8082/actuator/health || exit 1"],
      "interval": 15,
      "timeout": 5,
      "retries": 3,
      "startPeriod": 60
    },
    "cpu": 512,
    "memory": 1024
  }
]