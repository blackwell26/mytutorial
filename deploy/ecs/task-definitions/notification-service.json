[
  {
    "name": "notification-service",
    "image": "${ECR_REGISTRY}/mytutorial/notification-service:${IMAGE_TAG}",
    "portMappings": [{ "containerPort": 8083, "protocol": "tcp" }],
    "environment": [
      { "name": "SPRING_PROFILES_ACTIVE", "value": "k8s" },
      { "name": "EUREKA_CLIENT_SERVICEURL_DEFAULTZONE", "value": "http://eureka-server:8761/eureka/" },
      { "name": "SPRING_KAFKA_BOOTSTRAP_SERVERS", "value": "${KAFKA_BROKERS}" },
      { "name": "APP_KAFKA_TOPIC_AUTH-EVENTS", "value": "auth-events" },
      { "name": "APP_NOTIFICATION_FROM-EMAIL", "value": "noreply@mytutorial.com" },
      { "name": "APP_NOTIFICATION_FROM-NAME", "value": "MyTutorial Team" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/mytutorial/notification-service",
        "awslogs-region": "${AWS_REGION}",
        "awslogs-stream-prefix": "ecs",
        "awslogs-create-group": "true"
      }
    },
    "healthCheck": {
      "command": ["CMD-SHELL", "curl -sf http://localhost:8083/actuator/health || exit 1"],
      "interval": 15,
      "timeout": 5,
      "retries": 3,
      "startPeriod": 45
    },
    "cpu": 256,
    "memory": 512
  }
]