[
  {
    "name": "api-gateway",
    "image": "${ECR_REGISTRY}/mytutorial/api-gateway:${IMAGE_TAG}",
    "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
    "environment": [
      { "name": "SPRING_PROFILES_ACTIVE", "value": "k8s" },
      { "name": "EUREKA_CLIENT_SERVICEURL_DEFAULTZONE", "value": "http://eureka-server:8761/eureka/" },
      { "name": "SPRING_DATA_REDIS_HOST", "value": "${REDIS_ENDPOINT}" },
      { "name": "SPRING_DATA_REDIS_PORT", "value": "6379" }
    ],
    "secrets": [
      { "name": "APP_JWT_SECRET", "valueFrom": "${SECRET_ARN_JWT}" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/mytutorial/api-gateway",
        "awslogs-region": "${AWS_REGION}",
        "awslogs-stream-prefix": "ecs",
        "awslogs-create-group": "true"
      }
    },
    "healthCheck": {
      "command": ["CMD-SHELL", "curl -sf http://localhost:8080/actuator/health || exit 1"],
      "interval": 15,
      "timeout": 5,
      "retries": 3,
      "startPeriod": 50
    },
    "cpu": 512,
    "memory": 1024
  }
]